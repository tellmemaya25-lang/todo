# Non-secret parameters for the AI gateway (copy to .env.sabihon-todo or answer the prompts on first deploy).
# Secrets are NOT set here – use:  firebase functions:secrets:set AI_PRIMARY_API_KEY
#                                   firebase functions:secrets:set AI_FALLBACK_API_KEY   (enter "none" to disable fallback)
AI_DISABLED=false

# Primary provider – any OpenAI-compatible chat-completions endpoint.
AI_PRIMARY_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_PRIMARY_MODEL=gemini-2.5-flash-lite
AI_PRIMARY_LARGE_MODEL=gemini-2.5-flash
AI_PRIMARY_PRICES=0.10,0.40
AI_PRIMARY_LARGE_PRICES=0.30,2.50

# Fallback provider – a different vendor so one outage cannot take both down.
AI_FALLBACK_BASE_URL=https://api.openai.com/v1
AI_FALLBACK_MODEL=gpt-4o-mini
AI_FALLBACK_PRICES=0.15,0.60
